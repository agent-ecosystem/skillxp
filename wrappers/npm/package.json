  "bin": {
    "skillxp": "bin/skillxp.js"
  },
  "files": [
    "bin",
    "lib"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\""
  },
  "keywords": [
    "agent",
    "skills",
    "agent-skills",
    "claude-code",
    "codex",
    "antigravity",
    "headless"
  ],
  "author": "Dachary Carey",
  "license": "MIT",
  "homepage": "https://github.com/agent-ecosystem/skillxp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agent-ecosystem/skillxp.git",
    "directory": "wrappers/npm"
  },
  "optionalDependencies": {
    "skillxp-darwin-arm64": "0.0.0",
    "skillxp-darwin-x64": "0.0.0",
    "skillxp-linux-arm64": "0.0.0",
    "skillxp-linux-x64": "0.0.0"
  }
